rsor:pointer;background-color:transparent;background-image:none}\n.sc-tw img,.sc-tw svg,.sc-tw video,.sc-tw canvas,.sc-tw audio,.sc-tw iframe,.sc-tw embed,.sc-tw object{display:block;vertical-align:middle}\n.sc-tw img,.sc-tw video{max-width:100%;height:auto}\n.sc-tw .py-6{padding-top:1.5rem !important;padding-bottom:1.5rem !important}\n.sc-tw .flex{display:flex !important}\n.sc-tw .flex-wrap{flex-wrap:wrap !important}\n.sc-tw .justify-center{justify-content:center !important}\n.sc-tw .items-center{align-items:center !important}\n.sc-tw .gap-x-8{column-gap:2rem !important}\n.sc-tw .gap-y-3{row-gap:0.75rem !important}\n.sc-tw .text-sm{font-size:0.875rem !important;line-height:1.25rem !important}\n.sc-tw .font-medium{font-weight:500 !important}\n.sc-tw .gap-2{gap:0.5rem !important}\n.sc-tw .opacity-50{opacity:0.5 !important}",
